(defpoll hour	:interval "1s"	"date '+%H'")
(defpoll min	:interval "1s"	"date '+%M'")

;; Clock Widgets ;;
(defwidget clock-widget []
	(box	:orientation "v" 
			:class "time" 
			:valign "end"
	(button	:onclick ""	
			:class "time-hour" hour)
	(button	:onclick ""	
			:class "time-min"  min)))

(defwidget system-bar []
	(box :class "eww_bar" 
		 :orientation "v" 
		 :vexpand "false" 
		 :hexpand "false"
(clock-widget)))

